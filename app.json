{
  "expo": {
    "name": "OpenCircle",
    "slug": "opencircle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "opencircle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.amirhormazahash.opencircle",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app requires access to your photo library to allow you to select a profile picture during onboarding.",
        "NSCameraUsageDescription": "This app requires access to your camera to allow you to take photos and share them with your friends.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.amirhormazahash.opencircle",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F13",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app requires access to your photo library to allow you to select a profile picture.",
          "cameraPermission": "This app requires access to your camera to allow you to take a profile photo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F13",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OpenCircle uses your location to show how far away events are and to sort events by distance."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f901f57-bb05-48d2-ab19-c0f6cf65b084"
      }
    }
  }
}
