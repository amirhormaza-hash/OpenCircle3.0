# Copy to .env and fill in real values. Never commit .env.
# EXPO_PUBLIC_* values are embedded in the app bundle — restrict the
# Places key in Google Cloud Console (app + API restrictions).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
EXPO_PUBLIC_GOOGLE_PLACES_KEY=AIza...
# GIF search in chat (developers.giphy.com)
EXPO_PUBLIC_GIPHY_KEY=
